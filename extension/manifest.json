{
  "manifest_version": 3,
  "name": "Quarry button",
  "version": "0.1.0",
  "description": "Saves the open Instagram post's media for Quarry's capture sweep. Acts only when clicked.",
  "permissions": ["downloads", "scripting", "activeTab"],
  "host_permissions": ["https://www.instagram.com/*", "https://*.cdninstagram.com/*", "https://*.fbcdn.net/*"],
  "action": {"default_title": "Quarry: save this post"},
  "commands": {
    "_execute_action": {
      "suggested_key": {"default": "Alt+Shift+Q"},
      "description": "Save this post to Quarry"
    }
  },
  "background": {"service_worker": "service-worker.js"}
}
